// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String        @id @default(uuid())
  authId        String        @unique
  displayName   String    

  campaigns     Campaign[]
  sources       Source[]
}

model Campaign {
  id              String      @id @default(uuid())
  name            String
  slug            String
  ownerProfileId  String

  ownerProfile    Profile     @relation(fields: [ownerProfileId], references: [id])
}

model Source {
  id                    String      @id @default(uuid())
  name                  String
  slug                  String      @unique
  description           String
  ownerProfileId        String

  ownerProfile          Profile     @relation(fields: [ownerProfileId], references: [id])

  races                 Race[]
  subRaces              SubRace[]
  raceFeatures          RaceFeature[]
  materials             Material[]
  baseClasses           BaseClass[]
  subClasses            SubClass[]
  classFeatures         ClassFeature[]
  ammunitions           Ammunition[]
  items                 Item[]
  weapons               Weapon[]
  weaponProperties      WeaponProperty[]
  armors                Armor[]
  conditions            Condition[]
  languages             Language[]
  currencies            Currency[]
  spells                Spell[]
}

model Race {
  id            String            @id @default(uuid())
  name          String
  slug          String
  description   String
  sourceId      String
  
  source        Source            @relation(fields: [sourceId], references: [id])
  subRaces      SubRace[]
  features      RaceFeature[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model SubRace {
  id            String            @id @default(uuid())
  name          String
  slug          String
  description   String
  raceId        String
  sourceId      String
  
  source        Source            @relation(fields: [sourceId], references: [id])
  race          Race              @relation(fields: [raceId], references: [id])
  features      RaceFeature[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model RaceFeature {
  id                String            @id @default(uuid())
  name              String
  slug              String
  description       String
  type              FeatureType
  maxUses           Int?
  refreshPeriod     RefreshPeriod?
  raceId            String
  subRaceId         String?
  sourceId          String
  
  source            Source            @relation(fields: [sourceId], references: [id])
  race              Race              @relation(fields: [raceId], references: [id])
  subRace           SubRace?          @relation(fields: [subRaceId], references: [id])

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model BaseClass {
  id                  String              @id @default(uuid())
  name                String
  slug                String
  description         String
  hitDice             String  
  sourceId            String
  
  source              Source              @relation(fields: [sourceId], references: [id])
  subClasses          SubClass[]
  features            ClassFeature[]
  characterClasses    CharacterClass[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model SubClass {
  id                  String              @id @default(uuid())
  name                String
  slug                String
  description         String
  minLevel            Int
  baseClassId         String    
  sourceId            String
  
  source              Source              @relation(fields: [sourceId], references: [id])
  baseClass           BaseClass           @relation(fields: [baseClassId], references: [id])
  features            ClassFeature[]
  characterClasses    CharacterClass[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model ClassFeature {
  id              String            @id @default(uuid())
  name            String
  slug            String
  levelGained     Int
  type            FeatureType       @default(FEATURE)
  description     String
  maxUses         Int?
  refreshPeriod   RefreshPeriod?
  subClassId      String?
  baseClassId     String
  sourceId        String
  
  source          Source            @relation(fields: [sourceId], references: [id])
  baseClass       BaseClass         @relation(fields: [baseClassId], references: [id])
  subClass        SubClass?         @relation(fields: [subClassId], references: [id])

  @@unique([sourceId, slug], name: "source_slug_uk")
}

enum RefreshPeriod {
  SHORT_REST
  LONG_REST
  AT_DAWN
}

enum FeatureType {
  FEATURE
  ACTION
  BONUS_ACTION
  REACTION
}

model Inventory {
  id                      String              @id @default(uuid())
  name                    String
  capacity                Int
  type                    InventoryType
  characterId             String?

  character               Character?          @relation(fields: [characterId], references: [id])
  items                   InventoryItem[]
}

enum InventoryType {
  BACKPACK
  STORAGE
}

model InventoryItem {
  id            String              @id @default(uuid())
  name          String    
  itemType      InventoryItemType
  referenceId   String
  inventoryId   String

  inventory     Inventory           @relation(fields: [inventoryId], references: [id])

  @@index([referenceId, itemType], name: "item_reference_idx")
}

enum InventoryItemType {
  ITEM
  WEAPON
  ARMOR
  TOOL
  AMMUNITION
  TRINKET
}

model Ammunition {
  id            String            @id @default(uuid())
  name          String
  slug          String    
  description   String
  sourceId      String
  
  source        Source            @relation(fields: [sourceId], references: [id])
  weapons       Weapon[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model Item {
  id            String            @id @default(uuid())
  name          String
  slug          String
  description   String
  sourceId      String
  
  source        Source            @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model Weapon {
  id              String                        @id @default(uuid())
  name            String    
  slug            String
  description     String
  rangeFt         Int
  longRangeFt     Int?
  type            WeaponType
  ammunitionId    String?
  sourceId        String
  
  source          Source                        @relation(fields: [sourceId], references: [id])
  ammunition      Ammunition?                   @relation(fields: [ammunitionId], references: [id])
  damages         WeaponDamage[]
  properties      WeaponPropertiesOnWeapon[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

enum WeaponType {
  MELEE
  RANGED
}

model WeaponProperty {
  id            String                        @id @default(uuid())
  name          String
  slug          String 
  description   String
  sourceId      String
  
  source        Source                        @relation(fields: [sourceId], references: [id])
  weapons       WeaponPropertiesOnWeapon[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model WeaponPropertiesOnWeapon {
  weaponId      String
  propertyId    String
  sourceId      String

  weapon        Weapon          @relation(fields: [weaponId], references: [id])
  property      WeaponProperty  @relation(fields: [propertyId], references: [id])

  @@id([weaponId, propertyId])
}

model WeaponDamage {
  weaponId      String
  diceCount     Int
  dice          String
  type          DamageType
  
  weapon        Weapon        @relation(fields: [weaponId], references: [id])

  @@id([weaponId, type])
}

enum DamageType {
  ACID
  BLUDGEONING
  COLD
  FIRE
  FORCE
  LIGHTNING
  NECROTIC
  PIERCING
  POISON
  PSYCHIC
  RADIANT
  SLASHING
  THUNDER
}

model Armor {
  id                    String        @id @default(uuid())
  name                  String
  slug                  String        @unique
  description           String
  stealthDisadvantage   Boolean
  strengthRequired      Int?
  baseAC                Int?
  bonusAC               Int?
  type                  ArmorType
  sourceId              String
  
  source                Source            @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, slug], name: "source_slug_uk")
}

enum ArmorType {
  LIGHT
  MEDIUM
  HEAVY
  SHIELD
}

model Character {
  id                  String                    @id @default(uuid())
  name                String
  slug                String
  raceId              String
  subRaceId           String?
  strength            Int
  dexterity           Int
  constitution        Int
  intelligence        Int
  wisdom              Int
  charisma            Int
  spellcastingId      String?
  exhaustionLevel     Int?

  spellcasting        CharacterSpellcasting?

  skills              CharacterSkill[]
  inventories         Inventory[]
  characterClasses    CharacterClass[]
  profiencies         CharacterProficiency[]
  currencies          CharacterCurrency[]
  conditions          CharacterCondition[]
}

model ExhaustionEffect {
  id              String      @id @default(uuid())
  level           Int
  description     String
}

model CharacterCondition {
  characterId       String
  conditionId       String

  character         Character       @relation(fields: [characterId], references: [id])
  condition         Condition       @relation(fields: [conditionId], references: [id])

  @@id([characterId, conditionId])
}

model Condition {
  id                  String                @id @default(uuid())
  name                String  
  slug                String                @unique
  description         String
  sourceId            String
  
  source              Source                @relation(fields: [sourceId], references: [id])
  conditionEffects    ConditionEffect[]
  characters          CharacterCondition[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model ConditionEffect {
  id              String      @id @default(uuid())
  name            String      
  description     String
  conditionId     String

  condition       Condition   @relation(fields: [conditionId], references: [id])
}

model CharacterSpellcasting {
  id              String              @id @default(uuid())
  characterId     String              @unique
  maxPrepared     Int?

  character       Character           @relation(fields: [characterId], references: [id])
  spellSlots      SpellSlots[]
  spells          CharacterSpell[]
}

model SpellSlots {
  characterSpellcastingId     String     
  level                       Int          
  maxSlots                    Int
  slotsExpended               Int   

  characterSpellcasting       CharacterSpellcasting   @relation(fields: [characterSpellcastingId], references: [id])

  @@id([characterSpellcastingId, level])
}

model CharacterSpell {
  characterSpellcastingId       String
  spellId                       String
  prepared                      Boolean

  characterSpellcasting         CharacterSpellcasting   @relation(fields: [characterSpellcastingId], references: [id])
  spell                         Spell                   @relation(fields: [spellId], references: [id])

  @@id([characterSpellcastingId, spellId])
}

enum Ability {
  STRENGTH
  DEXTERITY
  CONSTITUTION
  INTELLIGENCE
  WISDOM
  CHARISMA
}

model CharacterClass {
  characterId         String
  baseClassId         String
  subClassId          String?

  character           Character     @relation(fields: [characterId], references: [id])
  baseClass           BaseClass     @relation(fields: [baseClassId], references: [id])
  subClass            SubClass?     @relation(fields: [subClassId], references: [id])

  @@id([characterId, baseClassId])
}

model CharacterSkill {
  characterId         String
  skill               Skill
  proficient          Boolean
  expert              Boolean

  character           Character       @relation(fields: [characterId], references: [id])

  @@id([characterId, skill])
}

enum Skill {
  ACROBATICS
  ANIMAL_HANDLING
  ARCANA
  ATHLETICS
  DECEPTION
  HISTORY
  INSIGHT
  INTIMIDATION
  INVESTIGATION
  MEDICINE
  NATURE
  PERCEPTION
  PERFORMANCE
  PERSUASION
  RELIGION
  SLEIGHT_OF_HAND
  STEALTH
  SURVIVAL
}

model CharacterProficiency {
  characterId       String
  type              ProficiencyType
  typeId            String
  sourceType        ProficiencySource
  sourceTypeId      String

  character         Character             @relation(fields: [characterId], references: [id])

  @@index([typeId, type], name: "type_typeId_idx")
  @@index([sourceTypeId, sourceType], name: "sourceType_sourceTypeId_idx")

  @@id([characterId, typeId])
}

enum ProficiencyType {
  WEAPON
  ARMOR
  LANGUAGE
  TOOL
}

enum ProficiencySource {
  CLASS
  SUB_CLASS
  RACE
  SUB_RACE
}

model Language {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  description     String
  sourceId        String
  
  source          Source                @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model Currency {
  id                      String                @id @default(uuid())
  name                    String
  slug                    String                @unique
  conversion              Int
  sourceId                String
  
  source                  Source                @relation(fields: [sourceId], references: [id])
  characterCurrencies     CharacterCurrency[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model CharacterCurrency {
  characterId         String
  currencyId          String
  amount              Int

  character           Character       @relation(fields: [characterId], references: [id])
  currency            Currency        @relation(fields: [currencyId], references: [id])

  @@id([characterId, currencyId])
}

model Spell {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  description         String
  level               Int
  verbal              Boolean
  somatic             Boolean
  material            Boolean
  sourceId            String
  
  source              Source                @relation(fields: [sourceId], references: [id])

  spellMaterials      SpellMaterial[]
  characterSpells     CharacterSpell[]

  @@unique([sourceId, slug], name: "source_slug_uk")
}

model SpellMaterial {
  spellId       String
  materialId    String

  spell         Spell         @relation(fields: [spellId], references: [id])
  material      Material      @relation(fields: [materialId], references: [id])

  @@id([spellId, materialId])
}

model Material {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  materialType      MaterialType
  materialTypeId    String
  sourceId          String
    
  source            Source            @relation(fields: [sourceId], references: [id])
  spellMaterials    SpellMaterial[]

  @@index([materialTypeId, materialType], name: "materialType_materialTypeId_idx")

  @@unique([sourceId, slug], name: "source_slug_uk")
}

enum MaterialType {
  ITEM
}

model MagicItem {
  itemId                        String
  magicItemType                 MagicItemType
  requiresAttunement            Boolean

  @@index([itemId, magicItemType], name: "magicItemType_itemId_idx")

  @@id([itemId, magicItemType])
}

enum MagicItemType {
  ITEM
  WEAPON
  ARMOR
}