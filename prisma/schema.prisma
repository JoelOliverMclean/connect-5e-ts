generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String    @id @default(uuid())
  authId        String    @unique
  displayName   String    

  campaigns     Campaign[]
}

model Campaign {
  id              String    @id @default(uuid())
  name            String
  slug            String
  ownerProfile    Profile    @relation(fields: [ownerProfileId], references: [id])
  ownerProfileId  String
}

model BaseClass {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique
  description   String
  hitDice       String  
}